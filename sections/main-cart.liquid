<div class="wrap dp-page dp-cart" style="max-width:960px">
  <h1>Il tuo carrello</h1>
  {%- if cart.item_count == 0 -%}
    <div class="dp-empty">
      <p style="color:var(--muted);font-size:17px">Il tuo carrello è vuoto.</p>
      <a class="dp-btn dp-btn--brand" href="{{ routes.root_url }}">Scopri Salvafrigo</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <table>
        <tbody>
          {%- for item in cart.items -%}
          <tr>
            <td class="dp-cart__media">
              <a href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
                {%- assign riga_img = item.image | default: item.product.featured_image -%}
                {%- if riga_img -%}
                  <img src="{{ riga_img | image_url: width: 220 }}" alt="" width="74" height="74" loading="lazy">
                {%- else -%}
                  <span class="dp-cart__ph" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>
                  </span>
                {%- endif -%}
              </a>
            </td>
            <td>
              <a href="{{ item.url }}" style="font-weight:700;text-decoration:none">{{ item.product.title }}</a>
              <div style="color:var(--muted);font-size:13px">Prodotto digitale</div>
              <a class="dp-cart__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                 aria-label="Rimuovi {{ item.product.title | escape }} dal carrello">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
                Rimuovi
              </a>
            </td>
            <td class="dp-cart__price">{{ item.final_price | money }}</td>
            <td class="dp-cart__qty">
              <label class="visually-hidden" for="Qty-{{ forloop.index }}">Quantità</label>
              <input id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"
                     style="width:64px;padding:8px;border:1px solid var(--line);border-radius:8px">
            </td>
            <td class="dp-cart__total">{{ item.final_line_price | money }}</td>
          </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:24px;flex-wrap:wrap;gap:14px">
        <div>
          <div style="font-size:20px;font-weight:800">Totale: {{ cart.total_price | money }}</div>
          <div style="color:var(--muted);font-size:13px;margin-top:4px">Prodotto digitale — nessuna spedizione.</div>
        </div>
        <div style="display:flex;gap:10px">
          <button type="submit" name="update" class="dp-btn" style="background:#fff;color:var(--ink);border:1px solid var(--line)">Aggiorna</button>
          <button type="submit" name="checkout" class="dp-btn dp-btn--brand">Vai al pagamento</button>
        </div>
      </div>
    </form>
    <p style="margin-top:14px"><a class="dp-cart__back" href="{{ routes.root_url }}#catalog">&larr; Continua gli acquisti</a></p>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
